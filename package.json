{
  "name": "hb",
  "private": true,
  "version": "0.1.0",
  "description": "Hörbuch-PWA für Kinder",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @hb/web",
    "build": "npm run build -w @hb/web",
    "preview": "npm run preview -w @hb/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "icons": "node tools/generate-icons.mjs",
    "rules": "node tools/render-rules.mjs",
    "rules:check": "node tools/render-rules.mjs --probe && npx --yes firebase-tools@^14.0.0 emulators:exec --only firestore --project demo-hb \"node tools/rules-check.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "sharp": "^0.35.4"
  }
}
