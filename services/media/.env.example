# Kopie als .env neben die docker-compose.yml legen. Diese Datei enthält
# Geheimnisse und gehört nicht ins Repository (.gitignore sperrt .env*).

# Pfad des Hörbuch-Ordners auf dem NAS, wird read-only eingehängt.
HB_LIBRARY_PATH=/share/Hoerbuecher

# Port, unter dem der Dienst auf dem NAS selbst erreichbar ist. Auf dem QNAP
# belegt die QTS-Weboberfläche bereits 8080, deshalb dort etwas Freies wählen.
HB_HOST_PORT=18080

# Projekt-ID aus der Firebase-Konsole.
HB_FIREBASE_PROJECT_ID=hoerbuchkinder

# Signaturgeheimnis der Media-Tickets, mindestens 32 Zeichen.
# Erzeugen mit:  openssl rand -base64 48
HB_TICKET_SECRET=

# Adresse der App. Mehrere durch Komma getrennt.
HB_ALLOWED_ORIGINS=https://hb.alae.app

# Firebase-UIDs, die Medien abrufen dürfen. Leer = jeder verifizierte Nutzer
# des Projekts. Bei aktivierter Google-Anmeldung unbedingt ausfüllen.
HB_ALLOWED_UIDS=

# UIDs, die einen Neu-Scan auslösen dürfen. Leer = alle zugelassenen.
HB_ADMIN_UIDS=

# Laufzeit der Media-Tickets in Sekunden (Vorgabe 8 Stunden).
HB_TICKET_TTL_SECONDS=28800

# Abstand automatischer Neu-Scans in Minuten. 0 schaltet sie ab; dann
# erscheinen neue Hörbücher erst nach einem Neustart oder /admin/rescan.
HB_RESCAN_INTERVAL_MINUTES=360

# Beim Start einmal einlesen.
HB_SCAN_ON_START=true

# Token des Cloudflare-Tunnels aus Zero Trust → Networks → Tunnels. Wird erst
# gebraucht, wenn der Tunnel mit --profile tunnel dazukommt; bis dahin leer
# lassen – der Medien-Dienst startet auch ohne.
CLOUDFLARE_TUNNEL_TOKEN=
