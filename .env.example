# Kopie als .env.local anlegen – .env* ist per .gitignore gesperrt.
# In Netlify werden dieselben Werte unter Site settings → Environment variables
# gesetzt.

# Basis-URL des Medien-Dienstes auf dem QNAP (Cloudflare Tunnel).
# Ohne abschliessenden Schrägstrich.
VITE_MEDIA_BASE_URL=https://hb-media.alae.app

# Firebase-Web-Konfiguration (ab M2).
# Diese Werte sind per Design öffentlich – der Schutz kommt von den
# Firestore-Regeln und der abgeschalteten Registrierung.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
