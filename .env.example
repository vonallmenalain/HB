# Kopie als .env.local anlegen – .env* ist per .gitignore gesperrt.
# In Netlify werden dieselben Werte unter Site settings → Environment variables
# gesetzt. Ohne sie zeigt die App den Bildschirm „Konfiguration fehlt“ und
# nennt die fehlenden Variablen beim Namen.

# Firebase-Web-Konfiguration.
# Diese Werte sind per Design öffentlich – sie landen ohnehin im ausgelieferten
# Bundle. Der Schutz kommt von den Firestore-Regeln, der Freigabeliste und der
# abgeschalteten Registrierung, nicht von ihrer Geheimhaltung.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Basis-URL des Medien-Dienstes auf dem QNAP (Cloudflare Tunnel), ab M3.
# Ohne abschliessenden Schrägstrich.
VITE_MEDIA_BASE_URL=https://hb-media.alae.app
